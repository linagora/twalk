{
	"name": "@twalk/companion",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"api:generate": "node scripts/generate-api-client.mjs",
		"api:check": "node scripts/generate-api-client.mjs --check",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"test": "npm run api:check && npm run check && npm run test:unit && npm run build && npm run test:e2e"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@lucide/svelte": "^1.47.0",
		"events": "^3.3.0",
		"intl-messageformat": "^12.1.0",
		"openapi-fetch": "^0.17.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22.0.0",
		"openapi-typescript": "^7.13.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"typescript": "^5.9.0",
		"vite": "^8.0.16",
		"vitest": "^5.0.1",
		"yaml": "^2.8.0"
	}
}
