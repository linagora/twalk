# Twalk reference deployment — environment file.
#
#   cp .env.example .env   — then edit the values below.
#
# compose.yaml reads this file; the secrets are yours to choose and are never
# hardcoded in the stack. Keep .env private (it is gitignored). Generate any
# of the secrets with e.g.:  openssl rand -hex 32

# --- Matrix homeserver (Synapse) --------------------------------------------

# The Matrix server name: the public DNS name of your homeserver. It appears
# in every user and room ID (@you:example.com) and cannot be changed later
# without re-creating the server.
MATRIX_DOMAIN=matrix.example.com

# Host port the Synapse client API is published on. Bound to localhost by
# default: in production the homeserver is fronted by your TLS reverse proxy
# on the same host (Synapse honors X-Forwarded-For, see x_forwarded in the
# config). Widen the binding in compose.yaml only if you know you need it.
MATRIX_HTTP_PORT=8008

# Secrets rendered into the Synapse config. The registration shared secret
# authenticates account provisioning (provision.sh); open registration is NOT
# enabled on this stack.
MATRIX_REGISTRATION_SHARED_SECRET=
MATRIX_MACAROON_SECRET=
MATRIX_FORM_SECRET=

# Full Matrix user ID of the human this deployment belongs to — you. A Twalk
# deployment serves one owner on any number of devices (ADR 0011). The bridges
# read it: it is the single account their provisioning API accepts a login
# from.
#
# It is the same human as GATEWAY_OWNER below, and it defaults to it — so with
# GATEWAY_OWNER set you can leave this empty, and you only ever have to
# disagree with it deliberately. It stays a variable of its own because a
# bridge's permission is not a Gateway concept: a stack can run bridges with
# no Gateway sign-in configured, and the reverse.
MATRIX_OWNER_USER_ID=

# How services inside the stack reach the homeserver. The compose service name
# is right for every normal deployment; change it only if you point the stack
# at a homeserver you run elsewhere.
MATRIX_INTERNAL_URL=http://synapse:8008

# Appservice registrations Synapse loads at startup: a comma-separated list of
# paths inside the bridge-registrations volume, which compose mounts at
# /registrations. Empty (the default) means no bridges, and is what the stack
# without the `bridges` profile needs.
#
# Synapse refuses to start on a path that does not exist, so this list must
# name exactly the bridges you provision — no more. ./provision-bridges.sh
# checks that before it generates anything and prints the line to paste.
# With all four bridges:
#
#   MATRIX_APPSERVICE_REGISTRATIONS=/registrations/whatsapp.yaml,/registrations/signal.yaml,/registrations/gmessages.yaml,/registrations/telegram.yaml
#
# The filenames are mautrix's own names for the bridges. `gmessages.yaml` is
# the SMS bridge's registration; `sms` is the network it serves and is not a
# filename here (ADR 0005). `telegram.yaml` is the Telegram bridge's, where the
# bridge id and the network value happen to coincide — a coincidence, not a
# rule.
MATRIX_APPSERVICE_REGISTRATIONS=

# --- Sensor -------------------------------------------------------------------

# Full Matrix user ID of the Sensor account; the provision one-shot service
# in compose.yaml creates it on the way up.
SENSOR_USER_ID=@sensor:matrix.example.com
# Password of the Sensor account. Generate one. Leave it empty only when you
# use the access-token pair below instead.
SENSOR_PASSWORD=

# Alternative to the password, for a homeserver where password login is
# disabled (`password_config.enabled: false` — the normal SSO-only setup):
# the access token of a device provisioned out of band, and the device ID it
# belongs to. Synapse's admin registration API returns both
# (POST /_synapse/admin/v1/register with the registration shared secret), and
# so does any SSO login. Set both or neither; the Sensor refuses to start
# with a half-configured pair.
#
# Two consequences worth knowing. The crypto store is bound to the device, so
# never point a new token at a state directory that belonged to another
# device — matrix-sdk refuses it, loudly. And without a password the SDK
# cannot answer an interactive-authentication challenge, so bootstrapping
# this account's cross-signing needs SENSOR_RECOVERY_KEY below, or a device
# you cross-signed yourself.
SENSOR_ACCESS_TOKEN=
SENSOR_DEVICE_ID=

# Comma-separated Matrix user IDs allowed to invite the Sensor into a room:
# the bridge bots and your own account. Invitations from anyone else are
# ignored.
#
# Name each bridge's bot here, or its portal rooms are never observed and you
# will be re-inviting the Sensor by hand for every conversation. The bots of
# the bridges this stack ships are @whatsappbot:<domain>, @signalbot:<domain>,
# @gmessagesbot:<domain> and @telegrambot:<domain> (they are
# `appservice.bot.username` in
# ../../bridges/mautrix-*/config.yaml, and each bridge's provisioning API
# reports its own as `bridge_bot` — read it there rather than trusting this
# list, which is a copy). They need no provisioning: a bridge creates its bot
# itself, through its appservice registration.
#
# With all four bridges and your own account:
#
#   SENSOR_ALLOWED_INVITERS=@you:matrix.example.com,@whatsappbot:matrix.example.com,@signalbot:matrix.example.com,@gmessagesbot:matrix.example.com,@telegrambot:matrix.example.com
SENSOR_ALLOWED_INVITERS=@you:matrix.example.com

# The same bridge bots again, and here for the opposite reason: not whose
# invitation to accept, but which accounts are not people (issue #152,
# ADR 0026). A bridge bot is the appservice's own service identity — it creates
# portals and puppets ghosts — so nothing is published about it: not its
# presence, not what it writes into a portal room, and no consent decision.
#
# Leave it empty and your bus fills up with it. Measured on the reference
# deployment: @whatsappbot and @signalbot produced 1,150 of 1,216 presence
# events, two a minute each, for as long as the stack runs — and worse than the
# volume, each one goes through the *contact* machinery, so your consent state
# can end up holding a row about a robot and the Companion can offer you a
# decision about one.
#
# Two lists rather than one because they answer different questions and
# SENSOR_ALLOWED_INVITERS also names *you*: deriving this from it would make
# your own presence — or that of a second account you trust to invite the
# Sensor — vanish from the bus as a side effect. An account you do not name
# here stays a contact, which is the safe failure: mistaking a contact for a
# bot deletes a real person from the stream silently.
#
# Copy the bot ids out of the line above, without your own account:
#
#   SENSOR_BRIDGE_BOTS=@whatsappbot:matrix.example.com,@signalbot:matrix.example.com
SENSOR_BRIDGE_BOTS=

# Check it worked: on /metrics,
# twalk_sensor_events_dropped_total{reason="bridge_bot"} climbs. A flat zero on
# a stack with bridges connected means one of these ids is misspelled, not that
# there was nothing to drop.

# Who the operator is, so the Sensor can tell your own messages apart from
# your contacts'. A portal room mirrors a conversation in both directions, so
# the Sensor sees what you send from your phone as well as what you receive;
# without this it publishes your own messages as a contact's, and a persona
# will happily suggest a reply to them (ADR 0018).
#
# It also governs your own reactions and your own presence (ADR 0021): your
# reactions are published as outbound.reaction.added, and your presence is not
# published at all. Without it, both go out as a contact's — and if you have
# granted a whole network, your own phone number is published with them as a
# contact's network identifier.
#
# The same human as GATEWAY_OWNER below, and it defaults to it, so you can
# normally leave this empty.
SENSOR_OWNER=

# The Matrix IDs your own messages arrive under, comma-separated. This one you
# have to fill in by hand, and here is why.
#
# A bridge does not relay your messages under your Matrix ID. It creates a
# *ghost* of your account on each network, and the ghost looks exactly like a
# contact's: same localpart prefix, same server, a display name that is just
# your name. Worse, there is usually more than one per network — a real
# WhatsApp account answers both a phone-number ghost and a LID ghost, and the
# messages you send may arrive under either:
#
#   @whatsapp_33612345678:matrix.example.com          "Your Name (WA)"
#   @whatsapp_lid-115332874281144:matrix.example.com  "Your Name (WA)"
#   @signal_75af9e9a-b173-4fa0-9228-03d4a03a1e2c:matrix.example.com  "Your Name"
#   @gmessages_<participant id>:matrix.example.com    "Your Name"
#   @telegram_<your telegram user id>:matrix.example.com  "Your Name"
#
# Telegram is the one where the expectation is a single ghost: an account has
# one integer Telegram user id and there is no analogue of WhatsApp's LID, so
# this list gains one entry rather than two. Read it off your own message all
# the same — one was also the expectation for WhatsApp, and a live account
# produced two.
#
# Nothing in the stack can resolve that set for you today: a bridge's
# provisioning API reports the *login* (your phone number, your Signal
# account UUID) and no ghost Matrix ID at all, and building one by string
# concatenation finds the phone ghost and misses the LID ghost. The Google
# Messages one is left as a shape above rather than an example on purpose:
# its localpart carries a participant id the bridge assigns, which is not
# your phone number and is not guessable — read it off your own message. So the Sensor
# is told, rather than guessing — and an identity you do not list stays a
# contact, which is the safe failure rather than a wrong exemption.
#
# How to read yours: send yourself a message on each network (Signal's Note to
# Self is ideal), open the portal room in any Matrix client, and look at the
# sender of your own message. That is the ID to add here. If you later see one
# of your messages appear as a contact's, a new ghost has started being used:
# add it and restart the Sensor.
#
# Empty (the default): the Sensor has no way to recognise you, and your own
# messages, reactions and presence are published as a contact's.
#
# THIS LIST IS ALSO THE COMPANION GATEWAY'S (ticket #149). You have no consent
# state either — you are never a contact, on any event — so the Gateway refuses
# a consent decision about one of these identities and serves none of them in
# its consent state or its snapshot. compose.yaml passes this same value to the
# Gateway as GATEWAY_OWNER_IDENTITIES, so **an existing deployment has nothing
# to change**: keep listing them here, and both components read one list.
#
# One consequence worth knowing before you add an identity: an upgraded
# deployment can already hold a consent row about one of your ghosts, because
# before #109 your own messages were published as a contact's. Nothing deletes
# it — the decision journal is append-only, and it is the audit trail of a
# promise — but from the moment an identity is in this list, no read of the
# Gateway serves its row: it disappears from the consent state, from the
# snapshot and from the list of contacts waiting for a decision, and the
# Gateway says how many such rows it is holding (a warning at startup, and
# twalk_companion_gateway_owner_consent_rows on /metrics). A row about a ghost
# you have *not* listed is still served, because an identity nobody confirmed
# is a contact — which is exactly why adding one here is the fix.
SENSOR_OWNER_IDENTITIES=

# The device of YOUR OWN Matrix account that Twalk acts through, and the device
# id that token was issued for: both, or neither ([#123], ADR 0025, ADR 0034).
#
# Why it exists. A mautrix bridge relays to its network only what the
# **logged-in user's own Matrix account** sends. An approved reply posted by
# @sensor: is ignored by the bridge without a log line: Synapse returns an event
# id, the Companion says the reply went out, and the contact receives nothing.
# With this set, the reply is posted by a device of your account, so the bridge
# relays it because it really is you — and the message arrives on the network
# from the person your contact was writing to.
#
# What it is. An ordinary login on your own account, named twalk in your device
# list; you can revoke it from any Matrix client, at any time, without touching
# anything else, and Twalk stops replying. It is **write-only**: it joins the
# portal rooms of the bridges SENSOR_BRIDGE_BOTS names — and nothing else, since
# a room id in an invitation is chosen by whoever sent the invitation — and
# posts approved replies. It reads no history, so it needs **no cross-signing
# and no recovery key**: your recovery key stays with you, and no Twalk
# component ever asks for it.
#
# What it costs. A long-lived credential for your own account sits on the
# sensor-data volume, which nothing encrypts at rest (issue #14) — the same
# exposure SENSOR_ACCESS_TOKEN already has, now covering your account as well as
# the Sensor's. It is bounded by being revocable from any client you already
# have.
#
# Empty (the default): the Sensor behaves exactly as before — it posts as itself
# — and says so once at startup and per reply, on
# twalk.persona.reply.approved.v1.posted with reach=nobody ([#216]). Setting
# only one of the two is refused at startup, and so is a token whose account is
# not SENSOR_OWNER: a token for the wrong account would otherwise be discovered
# by a contact receiving a reply from somebody else.
#
# [#123]: https://github.com/linagora/twalk/issues/123
# [#216]: https://github.com/linagora/twalk/issues/216
SENSOR_OWNER_DEVICE_ACCESS_TOKEN=
SENSOR_OWNER_DEVICE_ID=

# Directory the Sensor persists its session, sync token and crypto store in.
# Must stay on the sensor-data named volume, mounted at /data in the
# container.
# The state directory holds the session, sync token and crypto stores,
# unencrypted at rest by design decision (issue #14): the host volume is the
# operator's to protect (filesystem permissions, disk encryption).
SENSOR_STATE_DIR=/data

# Prometheus metrics listen address. Empty (the default): no metrics server
# at all. Set e.g. 0.0.0.0:9090 and add a ports mapping to the sensor service
# to scrape it.
SENSOR_METRICS_LISTEN=

# Log level filter, e.g. info or info,twalk_sensor=debug.
SENSOR_LOG_LEVEL=info

# Optional: the recovery key of the SENSOR ACCOUNT itself, the one you kept
# when provisioning that account. This is NOT your own recovery key: yours
# stays with you (your password manager, your paper) and no Twalk service
# ever holds it. When set, the Sensor recovers its own account's
# cryptographic identity and the backed-up room-key history on a
# replacement device.
SENSOR_RECOVERY_KEY=

# Where the Sensor reads the consent snapshot, and with what (ADR 0010).
#
# Leave BOTH empty and compose derives them from GATEWAY_SERVICE_TOKEN below,
# which is the one variable to set: the Companion Gateway's origin on this
# compose network, and the same token the Gateway checks — one secret, held by
# the service that checks it and by the service that sends it. The Sensor is a
# service and not one of your browsers: it has no Matrix sign-in and is never
# given a device token (ADR 0011). Set them here only to read a snapshot from
# a Gateway that is not this stack's.
#
# With GATEWAY_SERVICE_TOKEN empty too, no snapshot is read at all: the
# Sensor's consent cache starts cold, so every contact you granted labels
# `pending` again after each restart until you decide something new about it
# (issue #16), and every event is stamped with the implicit registry of
# connections — one per network, named after it (ADR 0033).
#
# With a Gateway configured and not answering, the Sensor WAITS: it starts,
# serves /metrics, and reads nothing from Matrix until the snapshot has been
# read, because the snapshot is what carries every granted contact and the
# registry of connections each event is stamped with, and an event published
# without them is mislabelled or misattributed for ever on the bus. Nothing is
# lost meanwhile — the homeserver holds what arrives and delivers it once the
# sync starts — and the wait is loud: an ERROR naming the URL, the
# twalk_sensor_consent_snapshot_failures_total counter, and a sync age that
# keeps growing until the Gateway is back.
#
# The two go together: the Sensor refuses to start with one of them set and
# not the other, because half a configuration degrades exactly like none at
# all, and silently.
SENSOR_GATEWAY_URL=
SENSOR_GATEWAY_SERVICE_TOKEN=

# Name `docker compose build` tags the Sensor image with, and the image the
# sensor service runs. Empty (the default): twalk/sensor:local, the right
# name for a single deployment on a host. Set it only when several stacks
# built from different checkouts share one Docker daemon and must not
# overwrite each other's image (issue #38) — which is what
# sensor/tests/deployment.rs does, one tag per compose project.
TWALK_SENSOR_IMAGE=

# --- Companion Gateway --------------------------------------------------------

# Host port the Companion's origin is published on: the PWA, and on the same
# origin the Gateway's health (/health) and metrics (/metrics) endpoints.
# Bound to localhost by default — in production it is fronted by your TLS
# reverse proxy on the same host, which is also where to block /metrics if it
# should not be public. Change it whenever something else on the host already
# holds 8080, which on a developer machine is common: the container-internal
# port stays 8080 either way.
GATEWAY_HTTP_PORT=8080

# Directory, inside the container, the Companion's static files are served
# from. The image builds the Companion (companion/, a SvelteKit static export)
# in its own Node stage and ships the result at
# /srv/companion. Change this only together with a volume in compose.yaml
# that provides the files — an absent or empty directory is not fatal, the
# origin then answers a clear 404 while health and metrics stay up.
GATEWAY_STATIC_DIR=/srv/companion

# The Companion's SPA fallback file, inside the directory above: what a path
# the build has no file for is served with, so that a deep link reloaded cold
# loads the app instead of 404ing. 200.html is the name SvelteKit's static
# adapter recommends; change it only if your Companion build uses another.
GATEWAY_FALLBACK_FILE=200.html

# Log level filter, e.g. info or info,twalk_companion_gateway=debug. The
# per-request log lines (method, path, status, duration, traceparent) are at
# debug: at info the Gateway logs only its lifecycle.
GATEWAY_LOG_LEVEL=info

# --- Companion Gateway: who may sign in ---------------------------------------

# The one human this deployment serves, as a full Matrix user ID — your own
# account on the homeserver above. The Companion signs in by sending a Matrix
# OpenID token; the Gateway verifies it at the homeserver and refuses every
# other identity, the Sensor's account included. One owner per deployment, any
# number of devices; multi-user deployments are out of scope (see
# docs/architecture/adr/0011-gateway-authenticates-with-matrix-openid.md).
#
# Leave it empty and nobody can sign in: the Companion's origin still comes
# up, its health and metrics endpoints answer, and every /api endpoint answers
# 503 naming this variable. Nothing can be decided until you set it.
GATEWAY_OWNER=@you:matrix.example.com

# The network ghosts of that same account, if you want to say it here rather
# than let it come from SENSOR_OWNER_IDENTITIES above (ticket #149). Leave it
# empty — the default — and compose passes that list to the Gateway, which is
# the point: the set cannot be derived from a bridge and it grows when a
# network starts using a new addressing scheme, so one list feeds both
# components instead of two lists drifting apart. Setting this overrides that
# for the Gateway only, which is what you want if you point a Gateway at
# somebody else's Sensor.
#
# Your own Matrix ID above is always one of your identities, so the invariant
# holds for it whether or not this is set.
GATEWAY_OWNER_IDENTITIES=

# Where the Gateway verifies an OpenID token: the base URL of the homeserver's
# federation API. The default reaches Synapse inside this compose network, and
# needs no change unless your homeserver lives elsewhere. Only one endpoint is
# used, /_matrix/federation/v1/openid/userinfo, which is unauthenticated by
# design — the Gateway holds no federation identity and no signing key.
GATEWAY_HOMESERVER_FEDERATION_URL=http://synapse:8008

# Directory, inside the container, the Gateway keeps its SQLite stores in: the
# device list and the digests of the tokens it issued (never a Matrix access
# token, and never an OpenID token — only a one-way digest of one), and the
# consent decision journal. Must stay on the gateway-data named volume,
# mounted at /data, or every device is signed out by each restart and every
# consent decision is lost. Unencrypted at rest, like the Sensor's state and
# for the same reason (issue #14): the host volume is yours to protect.
GATEWAY_STATE_DIR=/data

# Session lifetimes in seconds. Empty means the defaults: 15 minutes for the
# device token the browser sends on every request, 30 days for the refresh
# token that mints the next one. Shorten the first if you want a stolen cookie
# to die sooner; shorten the second if you want an idle device to be logged
# out sooner. Revoking a device from the Companion takes effect immediately
# either way.
GATEWAY_DEVICE_TOKEN_TTL=
GATEWAY_REFRESH_TOKEN_TTL=

# --- Companion Gateway: bootstrap ---------------------------------------------

# Where the Gateway relays account registration and sends the Sensor's
# invitations: the base URL of the homeserver's client API. Empty (the
# default): the federation URL above is used, which in this stack is the same
# host and port. Change it only if your homeserver's client API lives
# elsewhere.
GATEWAY_HOMESERVER_URL=

# The homeserver's registration shared secret — the same value as
# MATRIX_REGISTRATION_SHARED_SECRET above — which lets the Companion create
# your account on screen 2 while Synapse's own open registration stays off.
#
# What it can and cannot do. With it set, the Gateway can create exactly ONE
# account: the one named in GATEWAY_OWNER, exactly once. Every other username
# is refused, and once that account exists every further attempt is refused
# too, including after the Gateway's volume is wiped. What it cannot do is tell
# you apart from someone else before you have onboarded: until you finish
# screen 2, whoever can reach the Companion's origin can claim your account
# with a password of their choosing. So bring the stack up, onboard, and be
# done — or leave this empty and create the account yourself with
# ./provision.sh, in which case the registration endpoint answers 503 and the
# window never opens. See
# docs/architecture/adr/0011-gateway-authenticates-with-matrix-openid.md and
# docs/architecture/security-model.md.
#
# Your recovery key is not affected either way: it is generated in your
# browser and never sent to the Gateway (ADR 0014). The API has no field it
# could arrive in, and refuses a request that carries one.
GATEWAY_REGISTRATION_SHARED_SECRET=

# The Sensor's Matrix ID — who the Gateway invites into the rooms you select
# when you connect an existing Matrix account (screen 3d). Empty (the
# default): SENSOR_USER_ID above is used. The Sensor's own account stays
# provisioned by the stack; this only says who to invite, and the Sensor
# starts and runs whether or not the Gateway is up.
GATEWAY_SENSOR_USER_ID=

# --- Companion Gateway: connecting a network ----------------------------------
#
# Which bridges the Companion can log in to, listed by bridge_id. This is what
# turns the QR screen on: the Gateway then speaks that bridge's provisioning
# API with the secret below, holds the blocking step of the login itself, and
# the browser polls a small document — a phone that sleeps mid-scan loses a
# poll, not the login.
#
# Empty (the default): no network can be connected from the Companion, and
# GET /api/bridges answers an empty list. Set it to the bridges you actually
# run, which means enabling the `bridges` compose profile as well:
#
#   GATEWAY_BRIDGES=mautrix-whatsapp,mautrix-signal,mautrix-gmessages,mautrix-telegram
#
# Each id names its own variables — GATEWAY_BRIDGE_<ID>_URL,
# _PROVISIONING_SECRET and _NETWORK, where <ID> is the id upper-cased with `-`
# as `_`. compose.yaml already sets all three of them for each of these four bridges, from
# WHATSAPP_PROVISIONING_SECRET, SIGNAL_PROVISIONING_SECRET,
# GMESSAGES_PROVISIONING_SECRET and TELEGRAM_PROVISIONING_SECRET below: there
# is nothing else to fill in here.
#
# These are bridge ids and not networks. `mautrix-gmessages` serves the `sms`
# network, and compose.yaml sets that for you — the Gateway would refuse to
# start if `gmessages` were named as a network, because it is not one of the
# contract's networks (ADR 0005). In v0.2 the sovereign SMS Companion takes
# this place with the same network and a different bridge id.
# `mautrix-telegram` serves `telegram`, where the two words coincide; that is a
# coincidence and not a licence to derive one from the other.
#
# Listing `mautrix-telegram` here turns its card on in the Companion, and today
# that card cannot finish a login: Telegram asks its questions as typed answers
# (a phone number, the code it sends, a password for a two-factor account) and
# no screen renders a typed-answer step yet — the Companion half of #175. Until
# it lands, log the Telegram bridge in through its provisioning API or its
# management room; the deployment below is complete and the bridge is up and
# waiting.
#
# A login in flight lives in the bridge's memory and in the Gateway's, and
# survives a restart of neither. That is stated in the API's own errors
# (`login_lost`), not hidden.
#
# Bridge health rides the same list. Each bridge pushes its connection state
# at the Gateway (WHATSAPP_STATUS_ENDPOINT / SIGNAL_STATUS_ENDPOINT /
# GMESSAGES_STATUS_ENDPOINT / TELEGRAM_STATUS_ENDPOINT below),
# the Gateway verifies the push against that bridge's own AS token — which
# compose.yaml already passes it — and publishes each change on the bus as
# `bridge.status.changed.v1`. Set the AS tokens below and there is nothing
# else to fill in here; leave a bridge's AS token empty and its pushes are
# refused rather than trusted, because every container on this network can
# reach that port.
GATEWAY_BRIDGES=

# --- Companion Gateway: consent -----------------------------------------------
#
# Consent follows sign-in: with GATEWAY_OWNER set, the Gateway keeps an
# append-only journal of the decisions that owner takes (in GATEWAY_STATE_DIR
# above, on the gateway-data volume) and publishes each one on this stack's
# bus as consent.state.changed.v1 — the events the Sensor labels senders by,
# and the audit trail of the project's promise (ADR 0006, ADR 0010). The bus
# URL is fixed in compose.yaml, like the Sensor's.
#
# Without GATEWAY_OWNER nothing can be decided at all: the whole API answers
# 503, consent included, and the Gateway says so in its log.

# The service token a consumer reads the consent snapshot with
# (GET /api/consent/snapshot): the whole current state, with the bus sequence
# it reflects, which is how a component whose cache is cold recovers consent
# instead of labelling every sender pending until it hears a decision
# (ADR 0010). Generate one:
#
#   openssl rand -hex 32
#
# Its caller is a service and not a browser, so this is a token in
# configuration rather than a sign-in: the Sensor has no Matrix OpenID token
# of its own. It grants a read of every contact you ever decided about — keep
# it as private as the rest of this file, and use the same value in both
# halves once the Sensor reads the snapshot. Empty (the default): the snapshot
# endpoint answers 503 and nothing else changes; the Gateway refuses to start
# with a value shorter than 32 characters.
#
# THE SAME TOKEN OPENS THE RUNTIME'S SETTINGS (GET /api/settings/runtime), and
# since #184 the Hermes runtime actually reads them: the model and the language
# you chose in the Companion, which the runtime injects into each persona. So
# this one variable is what makes a preference set in the browser reach a
# persona at all — with it empty, the runtime has only what is written in this
# file, and it says so at startup. That one credential opens both is exactly
# why the RUNTIME reads the settings and a persona never does: a persona holding
# this token would hold the whole social graph too (ADR 0015).
GATEWAY_SERVICE_TOKEN=

# The largest snapshot the Gateway will serve, in (subject, network) entries.
# Empty (the default): 100000, which a personal deployment is nowhere near.
# There is no pagination: a state over the cap is refused with an error naming
# this variable, because a silently truncated snapshot would tell a consumer
# that contacts you granted were never decided about.
GATEWAY_CONSENT_SNAPSHOT_MAX_ENTRIES=

# The durable JetStream consumer the Gateway reads inbound.message.received
# through, to know who has written to you and is still waiting for a consent
# decision — the "N decisions waiting" the Companion shows. Empty (the
# default): companion-gateway-pending-contacts, which is right for a
# deployment with one Gateway, and a deployment has one Gateway.
#
# Set it only if you point a second Gateway at this bus — a staging copy, a
# migration running two at once — where sharing one durable name would split
# the inbound stream between them and leave each showing half the contacts.
# Renaming it makes the next start a first start: the Gateway reads the
# stream's whole history again, which is harmless (a sighting it already has
# changes nothing) and slow.
#
# What that projection stores is a contact's Matrix ID, the network it wrote
# on and the first and last time it did — never a message body, never a
# display name, never the network identifier
# (docs/architecture/security-model.md, residual risk 5).
GATEWAY_INBOUND_CONSUMER=

# How far back the Gateway searches the bus when you approve a suggestion
# (ticket #24), in stream positions. Empty (the default): 20000.
#
# The bus has no index from an event id to a position, so finding the
# suggestion you approved — and the message it answers, which is what names
# the room the reply goes to — means reading the stream. The read is bounded,
# and the bound is visible in the answer: a suggestion the search did not
# reach is refused as "out of reach" and never as "not found", because those
# are different facts and you would act differently on each.
#
# Raise it if this bus carries far more than one person's conversations and
# you see approvals refused as out of reach. The cost is a longer read, and
# only on the approval path. A suggestion that old has normally expired
# anyway: every suggestion carries an expiry (one hour by default), and an
# expired one is refused whatever this is set to.
GATEWAY_APPROVAL_LOOKUP_WINDOW=

# How often the Companion Gateway re-reads the portal register in the
# background, in seconds. Empty (the default): 300. `0` turns the background
# read off entirely.
#
# The register is the list of conversations your bridges have actually built,
# and which of them the Sensor is inside (issue #105). A bridge builds a
# portal room when a conversation becomes active — not once at login — so the
# list grows on its own all day, and nothing puts the Sensor into any of it
# until you choose. This variable decides only how stale /metrics may be
# about that: GET /api/portals always asks the homeserver there and then.
#
# The Gateway reads a bridge's portal rooms as that bridge's own bot, through
# GATEWAY_BRIDGE_<ID>_AS_TOKEN below. A bridge you leave that token unset for
# has none of its conversations read, and the register says so rather than
# quietly leaving them out of the totals.
#
# WHICH ACCOUNT does the asking is the other half, and getting it wrong is
# silent (issue #171): an appservice token on its own acts as the
# registration's sender_localpart, which ./provision-bridges.sh generates as a
# random localpart that is in no rooms. So compose names each bridge's BOT —
# @whatsappbot / @signalbot on your MATRIX_DOMAIN, which is what
# bridges/*/config.yaml calls its `bridge.bot_username`. Override with
# WHATSAPP_BOT_USER_ID / SIGNAL_BOT_USER_ID only if you renamed a bot.
#
# If GET /api/portals ever says every bridge is readable and yet lists no
# conversation, read the `asked_as` and `joined_rooms` it gives per bridge:
# an account joined to 0 rooms is either a network that has genuinely built no
# conversation yet, or this setting pointing at the wrong account.
GATEWAY_PORTAL_REFRESH_SECONDS=

# Where a member count becomes a crowd: a conversation with at least this many
# people has to have its size acknowledged in the chooser before the Sensor is
# put into it (#143), and a conversation whose room is replaced is followed
# automatically only below it — above, the decision returns to the chooser
# (ADR 0029). Empty: 20, the number the reference deployment measured. Below 2
# is refused: a threshold every two-person conversation crosses is not one.
# The Companion holds no number of its own; it reads this one (#252).
GATEWAY_CROWD_THRESHOLD=

# The registry of connections (ADR 0033): the accounts this deployment observes
# or acts through — the perimeters a consent decision is scoped to. Empty: one
# connection per bridge, named after its network (`whatsapp`, `signal`, …),
# which is the id every existing decision was migrated onto — plus `matrix`,
# the user's own account on the homeserver, which every deployment has.
# Declare it only to name a second account of one network, or a collector's
# connection:
#   id=kind[=label],...   e.g. mautrix-whatsapp=whatsapp=Home,
#                              mautrix-whatsapp-work=whatsapp=Work,
#                              mail-linagora=email=Twake Mail
# The bridge a connection rides is the GATEWAY_BRIDGES entry of the same id,
# else the only bridge of its kind; two connections of one kind are each
# named after their bridge, or refused. A kind is one of the contract's
# (contracts/cloudevents/v1/definitions/kind.schema.json). The Sensor stamps
# every event with the connection whose bridge bot built the room, read from
# the Gateway; a room whose bot no connection names publishes nothing, and
# the Gateway says at startup which bridge that is.
GATEWAY_CONNECTIONS=

# --- The model and the language (ticket #98) -----------------------------------
#
# WHERE THE MODEL IS SET: in the Companion, not here. The Gateway holds the
# endpoint, the model name and your native language, and serves them to the
# Hermes runtime, which injects them into each persona (ADR 0015, ADR 0016).
# You need no shell access to change a model, and there is no default: until
# you name one, a persona refuses to start and says so.
#
# THE SHAPE TO COPY. Put an OpenAI-compatible proxy in front of your model.
# The reference deployment runs LiteLLM in front of a Qwen model at OVH, so
# Twalk sees exactly this and nothing more:
#
#     base_url : http://127.0.0.1:4000/v1
#     model    : qwen
#     key      : a file on this host (below)
#
# Every provider peculiarity — a provider's real model id, `drop_params`,
# `additional_drop_params`, `reasoning_effort` — belongs in your proxy's own
# configuration, which is what a proxy is for. HERMES_LLM_PARAMS further down
# is the ESCAPE HATCH for a deployment with no proxy, not the normal way to
# run this.
#
# THE CREDENTIAL IS A FILE, and the file WINS over anything set from the
# browser (ADR 0015). Set HERMES_LLM_API_KEY_FILE below to a path on THIS
# host: compose mounts it read-only into both the Gateway and the runtime,
# and the Gateway then reports the credential as coming from the file even if
# somebody pasted one into the Companion. That is the normal production
# combination — the model name from the browser, the key from a file — not an
# exotic one. There is no separate GATEWAY_LLM_API_KEY_FILE to set: compose
# derives the Gateway's from that one variable, so the two cannot drift.
#
# An empty or unreadable file stops the Gateway at startup naming the
# variable, rather than quietly using the browser's value instead.
#
# ROTATING THE KEY NEEDS A RESTART. Both the Gateway and the Hermes runtime
# read this file ONCE, at startup, so writing a new key into it changes
# nothing until you restart them: `docker compose up -d --force-recreate
# companion-gateway hermes`. That is the same rule on both sides of the
# hand-off on purpose: a file re-read per request would turn a file deleted
# under a running service into a new way to fail silently. It is written here
# rather than left to be discovered, because the moment you need it is the
# moment you are rotating a key that has leaked.
#
# WHAT LANDS IN THE GATEWAY'S STORE. A credential you type into the Companion
# is written to settings.sqlite3 in GATEWAY_STATE_DIR, in cleartext, on an
# unencrypted volume (issue #14). It is never returned by the API — the
# Companion sees only its last four characters — but anyone who can read that
# volume can spend your model budget. Using the file avoids it entirely; see
# docs/architecture/security-model.md, residual risk 15.
#
# TESTING IT. POST /api/settings/model/probe (the Companion's "test" action)
# sends one one-token completion to the endpoint and tells you which of four
# things happened: it worked, nothing answered, it answered and refused, or
# it answered something that is not a chat completion. Those are four
# different problems with four different fixes, and they are four different
# answers on purpose.

# Name `docker compose build` tags the Companion Gateway image with, and the
# image the companion-gateway service runs. Empty (the default):
# twalk/companion-gateway:local, the right name for a single deployment on a
# host. Set it only when several stacks built from different checkouts share
# one Docker daemon and must not overwrite each other's image (issue #38) —
# which is what companion-gateway/tests/deployment.rs does, one tag per
# compose project.
TWALK_GATEWAY_IMAGE=

# --- Hermes: the runtime and the personas it hosts -----------------------------
#
# Hermes is part of the default stack (issue #158): `docker compose up -d
# --wait` starts it, it starts the personas below, and the loop can close —
# a contact writes, a persona drafts, you approve in the Companion, the reply
# reaches the room.
#
# Read this before you run it: the hermes service holds the host's Docker
# socket, because a persona ships as a container image and the runtime starts
# that image. A service holding that socket is root on the host. The
# alternatives were weighed in docs/architecture/adr/0023-the-deployment-
# starts-personas-through-the-hosts-docker-socket.md, and what you are
# accepting is in docs/architecture/security-model.md. If that is not a trade
# you want on this machine, set HERMES_PERSONAS empty: the container then
# runs, hosts nothing, says so in its log, and the rest of the stack is
# unaffected.
#
# The runtime and its persona containers run in the HOST's network namespace,
# which is what lets a persona reach an LLM proxy published on 127.0.0.1 (the
# reference shape) and the bus on NATS_PORT at the same time.

# The personas this deployment hosts: a JSON array of an id and an argv, on
# one line. The argv is the wrapper the Hermes image ships,
# `run-persona <container name> <image>` — it runs that image with the
# environment the runtime constructed for it and turns SIGTERM into a
# `docker stop`.
#
# Adding a third-party persona is one more object in this array, with that
# author's image, and no change to compose.yaml: a third-party persona takes
# the same path as this one (ADR 0008), and is handed none of the runtime's
# own credentials either way.
#
# The image name here must match TWALK_PERSONA_IMAGE below (empty there means
# twalk/persona-assistant:local, which is what this line says). Empty: Hermes
# hosts nothing and says so.
HERMES_PERSONAS=[{"id":"assistant","command":["run-persona","twalk-persona-assistant","twalk/persona-assistant:local"]}]

# Where the Hermes runtime reads the model and the language YOU chose in the
# Companion, and with what (#184, ADR 0015, ADR 0016).
#
# Leave BOTH empty and compose derives them from GATEWAY_SERVICE_TOKEN above,
# which is the one variable to set — exactly as it does for the Sensor's
# snapshot pair. The URL is this stack's Gateway on the host's loopback
# (127.0.0.1:<GATEWAY_HTTP_PORT>) rather than its compose service name, because
# the runtime is in the HOST's network namespace (ADR 0023). Set them here only
# to read the settings from a Gateway that is not this stack's.
#
# With GATEWAY_SERVICE_TOKEN empty too, nothing is read: the model and the
# language are whatever is written in THIS FILE, and a preference you set in the
# Companion never reaches a persona. The runtime says which value came from
# where at startup, so that is visible rather than mysterious.
#
# WHEN IT IS READ: once, at startup. A model or a language changed in the
# Companion afterwards takes effect on the next `docker compose restart hermes`
# — the runtime says so in the same startup line. The one exception is a
# deployment that has no model at all: it keeps asking until there is one and
# then starts the personas, because that is an outage to get out of rather than
# a preference to chase.
#
# AN UNREACHABLE GATEWAY DOES NOT STOP ANYTHING. The runtime starts anyway,
# names the URL at ERROR, says what it fell back to, and hosts the personas on
# whatever this file named — the same answer the Sensor gives for the consent
# snapshot. A URL set here with no token is refused at startup; a token with no
# URL is not, and is reported as a credential that reads nothing.
HERMES_GATEWAY_URL=
HERMES_GATEWAY_SERVICE_TOKEN=

# The model your personas reason with, AS THE OPERATOR PINS IT. Since #184 the
# ordinary shape is to leave both empty: the runtime reads the model the user
# chose in the Companion from the Gateway (GET /api/settings/runtime) and
# injects it into each persona, so a model named here OVERRIDES what the user
# chose — what is supplied on this host wins over what was set from the browser,
# which is the order ADR 0015 already set for the credential. The runtime logs
# which value came from where at startup, so a pin is never invisible.
#
# There is no default and Twalk ships no LLM (ADR 0015): with these empty AND no
# Gateway configured (GATEWAY_SERVICE_TOKEN), Hermes hosts nothing rather than
# sending your messages to a model you did not name. With a Gateway and no model
# named anywhere yet, Hermes runs, says it is hosting nothing, and starts the
# personas the moment a model is named in the Companion — no restart needed.
#
# WHERE IT HAS TO BE REACHABLE. The runtime hands this URL to each persona
# unchanged, and both run in the host's network namespace, so any address the
# HOST can reach works — including a proxy bound to 127.0.0.1, which is the
# reference deployment's own shape:
#
#   HERMES_LLM_BASE_URL=http://127.0.0.1:4000/v1   # a LiteLLM proxy on this host
#   HERMES_LLM_MODEL=qwen                          # a model IT serves, by its name there
#
# An OpenAI-compatible chat-completions base URL; the model name is the one
# your endpoint knows, not a family name.
HERMES_LLM_BASE_URL=
HERMES_LLM_MODEL=

# The endpoint's credential, if it needs one. Prefer the file: a path ON THIS
# HOST, mounted read-only into the container, and it WINS over
# HERMES_LLM_API_KEY, so a production stack can keep the secret out of .env
# (ADR 0015). A path that does not exist becomes a directory rather than a
# file, and the runtime then refuses to start — check the path if you see
# that.
#
# The same path is mounted into the Companion Gateway, whose own credential
# it also wins over (ticket #98): one file, one entry here, and no second
# variable that could drift from this one. BOTH read it once at startup, so
# rotating the key means restarting both — see "ROTATING THE KEY NEEDS A
# RESTART" in the Gateway section above. A worked example, which is what the
# reference deployment runs:
#
#     HERMES_LLM_BASE_URL=http://127.0.0.1:4000/v1
#     HERMES_LLM_MODEL=qwen
#     HERMES_LLM_API_KEY=
#     HERMES_LLM_API_KEY_FILE=/home/you/deploy/secrets/litellm-master.key
#     HERMES_LLM_PARAMS=
#
# Note what is empty there: the inline key, because the file supplies it, and
# the provider passthrough, because the proxy handles the provider.
HERMES_LLM_API_KEY=
HERMES_LLM_API_KEY_FILE=

# Provider parameters merged into every completion request untouched, as a
# JSON object. THIS IS THE ESCAPE HATCH, not the normal way to run Twalk: if
# you put an OpenAI-compatible proxy in front of your model — the recommended
# shape, and the reference deployment's — every provider quirk belongs in the
# proxy's configuration and this stays empty. Use it when you talk to a
# provider directly and it rejects something an OpenAI client sends, which is
# why the passthrough exists at all (OVH's AI Endpoints needed exactly that).
#
# A parameter set to null REMOVES a field the request would otherwise carry,
# which is how an endpoint that rejects one is made to work. They are merged
# LAST, so they also override what the persona asked for. Example:
#   HERMES_LLM_PARAMS={"top_p":0.9,"frequency_penalty":null}
#
# **If your model reasons before it answers, the budget is here.** A reasoning
# model charges its thinking to the same budget as its answer, and the
# `assistant` persona used to ask for 300 tokens: it spent all of them on
# `reasoning_content`, the answer came back `HTTP 200` with
# `finish_reason: "length"` and no content at all, and the persona retried.
# Seen on this project's own reference host, with a Qwen model behind a
# LiteLLM proxy (#162). Two things changed and neither is a setting here: the
# persona now asks for 2000 tokens, and the SDK names that outcome, refuses
# the trigger instead of retrying it, and says in its log that the budget was
# spent on reasoning and where a larger one is set. So this stays empty
# unless your model needs more room than 2000 tokens:
#   HERMES_LLM_PARAMS={"max_tokens":4000}
HERMES_LLM_PARAMS=
# Seconds a persona waits for a completion; empty is the SDK's own default.
HERMES_LLM_TIMEOUT_SECONDS=

# How long a suggestion stays approvable, in seconds, counted from when it was
# produced. Empty is an hour. The Companion Gateway refuses an expired one:
# a reply drafted this morning is not one you want to send tonight without
# reading it again.
HERMES_SUGGESTION_TTL_SECONDS=

# The user's own language: one of en, fr, it, es, de, and the one thing a
# persona falls back to when it cannot tell what language the message it is
# answering was written in (ADR 0016, #164). It NEVER governs a suggestion
# whose language the persona can tell — a French user answering an
# English-speaking contact must not be handed French, which is the mistake
# the ADR exists to refuse.
#
# It is the user's preference, not the operator's setting: it belongs on the
# Companion's settings screen, the Gateway stores it, and this variable is
# how an OPERATOR OVERRIDES it. Since #184 the runtime reads the stored
# preference from the Gateway itself, so the ordinary shape is to leave this
# empty and set the language in the Companion; a value here wins over the one
# the user chose, on exactly the same terms as the model above.
#
# Empty is supported and is not "English": the personas answer in
# each message's own language, and an ambiguous one — a greeting, a single
# word, an emoji, a link — is answered in whatever language the model picks.
# On the reference deployment that was English, for a French speaker who had
# written `test`. Short messages are the common case.
#
# A value outside the five is refused at startup, with the five named.
HERMES_USER_LANGUAGE=

# --- The seam to Hermes (ticket #206, ADR 0032) ----------------------------
#
# Hermes here means **Nous Research's agent runtime**, which is outside this
# project and outside this deployment — not the persona runtime in this
# compose file, which the ADRs now call the persona runtime and whose
# variables still say HERMES_ (the rename is prose-only for now).
#
# Empty on all of these is a deployment with no seam, and that is what this
# file has always described: the personas reason with the model endpoint above
# and nothing leaves the deployment. Filled in, a persona stops drafting and
# instead posts a **signed webhook** to one of Hermes's routes; Hermes
# reasons, and its answer comes back to the Companion Gateway, which turns it
# into exactly the `persona.suggest.produced` a persona would have published.
# The user sees it on the same /approvals screen, and nothing is ever sent
# without their approval.
#
# ## The Twalk side
#
# HERMES_WEBHOOK_URL is one of Hermes's routes. It is injected into every
# persona; a URL with no secret is a startup refusal, because Hermes itself
# refuses a route that has none.
#
# **Use https.** The HMAC signature authenticates the sender and not the
# content — Nous Research's own documentation says so — so plaintext gives
# the user's messages no confidentiality at all. An http:// URL is refused
# unless HERMES_WEBHOOK_ALLOW_INSECURE_URL says otherwise, and the persona
# then warns on every start naming the URL. "Both ends are on one host today"
# is a decision somebody has to make, not a default.
#
# GATEWAY_HERMES_ANSWER_SECRET is the **other** secret, for the other
# direction: what Hermes's outbound hook signs each answer with. Generate
# both with `openssl rand -hex 32`. They are not the same secret and neither
# opens anything else on this deployment.
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=
HERMES_WEBHOOK_TIMEOUT_SECONDS=
HERMES_WEBHOOK_ALLOW_INSECURE_URL=
GATEWAY_HERMES_ANSWER_SECRET=
# The authority of the `source` URI a suggestion published from an answer
# carries. Empty: HERMES_DOMAIN below, which is what one deployment wants.
GATEWAY_HERMES_DOMAIN=
# How long such a suggestion stays approvable. Empty: HERMES_SUGGESTION_TTL_SECONDS,
# and then the same hour the personas use.
GATEWAY_SUGGESTION_TTL_SECONDS=
#
# ## The Hermes side, which is not this deployment's to configure
#
# Twalk configures the seam and never the agent (ADR 0032), so the rest lives
# in Hermes's own `config.yaml`, on the host that runs it. Give it a
# **profile of its own** — its own HERMES_HOME — because memory is per profile
# and two writers in one home compound into state neither authored; and set
# `memory.write_approval: true`, so a human stands between an inference about
# the user and its permanence.
#
#   model:
#     provider: openai-api          # any OpenAI-compatible endpoint
#     default: qwen
#     base_url: http://127.0.0.1:4000/v1
#   memory:
#     write_approval: true
#   platforms:
#     webhook:
#       enabled: true
#       extra:
#         host: 127.0.0.1
#         port: 8644
#         # Hermes's default is 30 requests a minute per route. A persona
#         # activated today reads the bus from the beginning (ADR 0013), so
#         # its first minutes replay every message the deployment ever saw —
#         # and at 30/min each 429 costs a trigger a redelivery it does not
#         # get back. 120 drains a day's backlog in minutes and is still a
#         # ceiling.
#         rate_limit: 120
#         routes:
#           twalk-messages:
#             events: ["twalk.message.received"]
#             secret: "<HERMES_WEBHOOK_SECRET>"
#             # A body whose template this prompt was not written for is
#             # ignored rather than half-rendered.
#             filters:
#               - field: "template_version"
#                 equals: 1
#             prompt: |
#               ... {message} ... {network} ... {user_language} ...
#               Answer with ONE JSON object and nothing else:
#               {"reference": "{reference}", "reply": "...", "language": "<BCP-47 tag>"}
#             deliver: log
#   hooks:
#     outbound:
#       - name: twalk-gateway
#         url: https://<this gateway>/_twalk/hermes/answers
#         events: [transform_llm_output]
#         secret_env: TWALK_ANSWER_SECRET     # = GATEWAY_HERMES_ANSWER_SECRET
#
# The `language` member is required and an answer without one is **refused**,
# loudly, rather than defaulted: a reply's disclosure is written in the
# language of the reply and not the user's (ADR 0031), and a silent default is
# how a French disclosure ends up under an English reply.

# The authority in every hosted persona's `source` URI
# (hermes://<domain>/personas/assistant). Empty: MATRIX_DOMAIN, which is what
# one deployment wants — it is the name this deployment answers for.
HERMES_DOMAIN=

# Where the runtime and its personas find the bus. Empty:
# nats://127.0.0.1:<NATS_PORT>, this stack's own bus through its published
# port — the address that is true both inside the host's network namespace
# and for the persona containers, which is why it is not nats://nats:4222.
HERMES_NATS_URL=
# The stream and the subject prefix, `twalk` in every deployment. Empty
# leaves the runtime's defaults; change them only if this bus is shared.
HERMES_BUS_STREAM=
HERMES_BUS_SUBJECT_PREFIX=

# Log levels: the runtime's own, and the personas' (their lines are forwarded
# through the runtime's stdout, so this is how you make one persona verbose
# without making the supervisor noisy).
HERMES_LOG_LEVEL=info
HERMES_PERSONA_LOG_LEVEL=info

# Names of the runtime's own environment variables a persona's argv may
# inherit, comma-separated. Empty is the runtime's default, PATH — which is
# how `run-persona` finds the docker client. Everything a persona legitimately
# needs is injected by the runtime from a closed list; this is the deliberate,
# auditable exception, and what you add here shows up in `docker inspect`.
HERMES_PERSONA_ENV_PASSTHROUGH=

# The Docker socket the runtime starts persona containers through. Empty:
# /var/run/docker.sock, the system daemon — root on this host.
#
# The one mitigation that costs nothing: point this at a ROOTLESS daemon's
# socket (typically /run/user/<uid>/docker.sock) and the grant narrows from
# root to that account. Add DOCKER_HOST to HERMES_PERSONA_ENV_PASSTHROUGH if
# your client needs it to find that daemon.
HERMES_DOCKER_SOCKET=

# Supervision, all empty for the runtime's own defaults. A persona that dies
# is restarted with backoff; a persona that never stays up is a different
# fact and is announced as one — a run shorter than HEALTHY_AFTER never
# started, and START_FAILURES of those in a row is logged once as
# `persona failed to start`, after which the runtime keeps trying so that
# fixing the image is enough.
#   HEALTHY_AFTER_MS 10000, START_FAILURES 3, backoff 1000 → 60000,
#   SHUTDOWN_GRACE_MS 10000 (how long a persona gets after SIGTERM).
HERMES_PERSONA_HEALTHY_AFTER_MS=
HERMES_PERSONA_START_FAILURES=
HERMES_RESTART_BACKOFF_BASE_MS=
HERMES_RESTART_BACKOFF_MAX_MS=
HERMES_SHUTDOWN_GRACE_MS=

# Names `docker compose build` tags the two Hermes-side images with, as
# TWALK_SENSOR_IMAGE and TWALK_GATEWAY_IMAGE do for theirs (issue #38). Empty:
# twalk/hermes:local and twalk/persona-assistant:local. If you change the
# persona one, change the image named in HERMES_PERSONAS with it.
TWALK_HERMES_IMAGE=
TWALK_PERSONA_IMAGE=

# --- Clerk: the owner's Buzz channels, fed from the bus -----------------------
#
# The clerk (ticket #265, ADR 0035) is part of the default stack: `docker
# compose up -d --wait` starts it, and with the variables below empty it runs,
# says in its log which are missing and hosts nothing — a stack without Buzz
# still comes up. Filled in, it writes onto YOUR Buzz relay what the bus says:
# one forum post per suggestion in `approbations`, deleted when the suggestion
# expires; one line per posted reply in `journal`; what calls for a look in
# `activite`. It writes under a Nostr key of its own — a third identity beside
# yours and Hermes's — and never quotes a contact: a post is the suggestion's
# body and the clerk's own sentences. It holds no state; the relay is its
# memory. It runs in the HOST's network namespace, like hermes, because the
# relay is reached by the URL it announces.
#
# Three steps, in this order, before anything here is set:
#   1. ./provision-nostr-key.sh /etc/twalk/clerk.env — the clerk's key, with
#      its public half printed, which the relay has to be told to accept
#      (`./run.sh add-member <hex>` in Buzz's compose bundle).
#   2. ./provision-buzz-channels.sh --bot <that hex pubkey> — the channels,
#      the clerk a member of each, and the three CLERK_CHANNEL_* lines printed.
#   3. Copy what was printed into this file, then `docker compose up -d clerk`.

# The URL your relay ANNOUNCES — its own RELAY_URL — scheme, host and port,
# no trailing slash, no path. Not "a URL that reaches the relay": NIP-98 binds
# every signed request to exactly this URL and the relay is multi-tenant by
# host, so a request signed for another spelling of the same relay is refused.
# On the reference deployment: https://buzz.maudet.cloud, a Caddy on this host
# in front of the relay's compose bundle. Empty: the clerk hosts nothing.
CLERK_RELAY_URL=

# The clerk's own Nostr key, as a file: a path ON THIS HOST, mounted read-only
# into the container. `./provision-nostr-key.sh /etc/twalk/clerk.env` writes
# it — BUZZ_PRIVATE_KEY=<hex>, mode 0600, and never twice, because a key that
# rotates is an identity the relay no longer knows — and prints the public
# half, which YOU tell the relay to accept (`./run.sh add-member <hex>` in
# Buzz's compose bundle): a relay with restricted writes refuses a key it was
# not told about. Leave the file 0600 and owned by whoever ran the script: the
# clerk refuses a looser one, and the container copies it for its own
# unprivileged account rather than asking you to change the owner. A path
# that does not exist becomes a directory rather than a file, and the
# container then refuses to start naming this variable — check the path if
# you see that. Empty: the clerk hosts nothing.
CLERK_NOSTR_KEY_FILE=

# The three channels the clerk writes to, by UUID — the identity of a channel;
# its name is only display. `./provision-buzz-channels.sh --bot <pubkey>`
# creates them as YOU (with your own key, read from a file and never printed),
# adds the clerk as a `bot` member of each, and prints these three lines ready
# to paste. No UUID is typed by hand. Empty on any of them: the clerk hosts
# nothing.
CLERK_CHANNEL_APPROVALS=
CLERK_CHANNEL_ACTIVITY=
CLERK_CHANNEL_JOURNAL=

# The language the clerk writes its OWN sentences in: one of en, fr, it, es,
# de. It quotes no contact and posts a suggestion's body as it was, so this is
# the only language its lines ever appear in. Set it here explicitly: on the
# reference deployment the personas' language comes from the Companion's own
# settings (#184), which the clerk cannot read — that read takes the
# Gateway's service token, which the clerk holds no copy of, by design — so
# HERMES_USER_LANGUAGE above is typically empty and does not carry what the
# user actually chose. Empty here means English, and the clerk warns at
# startup that it is unset. A value outside the five is refused at startup,
# with the five named. Since #284 it is also the language a refusal from the
# Companion Gateway is answered in, in the post's thread, with the
# Companion's own sentence for that code.
CLERK_USER_LANGUAGE=

# --- The clerk's write half: your ✅ on Buzz is the approval (#284) --------
#
# With the four variables below set, a ✅ you put on a post in `approbations`
# — or a reply in its thread, to send another text — becomes THE approval:
# the Companion Gateway's, through POST /api/approvals, exactly as the
# Companion's approval screen makes it. Buzz decides nothing (ADR 0032). A ❌
# deletes the post and reaches nothing. The clerk does this as A DEVICE OF
# YOURS on the Companion Gateway, named "Buzz" — listed on the dashboard
# beside your phone and your browser, revoked there the same way — and holds
# for it one refresh token, in a file, and nothing else of the Gateway's:
# not the service token, not a device token at rest (ADR 0036). Leave all
# four empty and the clerk runs its read half alone, saying at startup that
# a ✅ decides nothing.
#
# Two steps, after the three above:
#   4. Set CLERK_OWNER_PUBKEY and CLERK_GATEWAY_SESSION_DIR here.
#   5. ./provision-clerk-device.sh, with the Gateway and Synapse UP (it signs
#      in at the Gateway with a token Synapse mints — so `docker compose up
#      -d --wait` on the whole stack between steps 4 and 5 has the clerk
#      restarting until this runs, and nothing else affected) — your Matrix
#      password at the terminal (never an argument, never echoed, never
#      written), one Matrix OpenID token, one sign-in as the device "Buzz",
#      the session written into that directory at mode 0600 — then `docker
#      compose up -d clerk`. Run it again whenever the device is dead:
#      revoked from the dashboard, or its refresh token unused for thirty
#      days (a clerk asleep that long); after the first start that is
#      `sudo --preserve-env=TWALK_OWNER_PASSWORD_FILE ./provision-clerk-device.sh`
#      unless you are root, and then `docker compose restart clerk` (`up -d`
#      does not restart an unchanged container). It is idempotent and safe
#      to run beside a running clerk: an alive session is refreshed and kept,
#      a dead one replaced, and every other device named "Buzz" revoked so
#      there is one. On a homeserver with no password login (SSO only), or
#      away from a terminal, `./provision-clerk-device.sh --from-owner-device`
#      makes no login and mints the token with SENSOR_OWNER_DEVICE_ACCESS_TOKEN
#      above — the Sensor's device, which it never logs out — so the clerk's
#      Gateway device depends on nothing this deployment did not already
#      hold; the password stays the default because a credential you type is
#      one you did not have to store.

# YOUR Nostr public key — the one key whose ✅ is an approval — as 64 hex
# characters (not npub1…; `./provision-buzz-channels.sh` prints it in that
# form from your key file). From configuration and never read off the relay:
# a relay that could name a second approver would be an authority, and a
# relay `admin` is not you. A ✅ by any other key makes no Gateway call, is
# answered in the thread ("only the owner approves"), and is counted. Empty:
# the write half is off.
CLERK_OWNER_PUBKEY=

# A directory ON THIS HOST, of its own and holding nothing else, for the
# clerk's session on the Companion Gateway: one file, `session`, holding
# TWALK_GATEWAY_REFRESH_TOKEN=<token>, which ./provision-clerk-device.sh
# writes and the clerk rewrites on every refresh. A directory rather than the
# file, because the rewrite is atomic — a temporary file beside it, renamed
# over — and a bind-mounted file cannot be renamed over from inside a
# container. Mounted read-write; the container takes the directory and the
# file over for its own unprivileged account at its first start — which is
# why it must hold nothing but that session: pointed at your home or at
# /etc/twalk, the clerk refuses to start rather than chown it — so an
# operator who is not root comes back to it with sudo, and the script keeps
# the file's owner when it writes as root. Set with CLERK_OWNER_PUBKEY empty,
# the clerk refuses to start naming what is missing; set with no session in
# it yet, likewise, naming the script. Empty: the write half is off.
CLERK_GATEWAY_SESSION_DIR=

# The Companion Gateway as the clerk reaches it: scheme, host and port, no
# trailing slash, no path. Empty: this stack's Gateway on the host's loopback,
# http://127.0.0.1:<GATEWAY_HTTP_PORT>, which is right for the reference
# deployment — the clerk is in the host's network namespace. Name your public
# origin instead only if the Gateway is not published on this host.
CLERK_GATEWAY_URL=

# How often, in seconds, the clerk reads the gestures on its own posts and
# carries a ✅ to the Companion Gateway. Empty: 5; at least 1. Two relay
# queries a tick, three when a gesture is pending, out of the relay's 300 a
# minute per key.
CLERK_DECISION_SECONDS=

# Host port /health and /metrics are served on, bound to 127.0.0.1: the clerk
# is in the host's network namespace, so this is the port itself and not a
# mapping. Empty: 8084.
CLERK_LISTEN_PORT=

# How often, in seconds, the clerk looks in `approbations` for a post whose
# suggestion has expired and deletes it. Empty: 60; at least 1.
CLERK_SWEEP_SECONDS=

# The clerk's log level. Empty: info.
CLERK_LOG_LEVEL=

# Name `docker compose build` tags the clerk image with, as TWALK_SENSOR_IMAGE
# does for the Sensor's (issue #38). Empty: twalk/clerk:local.
TWALK_CLERK_IMAGE=

# --- Bridges (mautrix-whatsapp, -signal, -gmessages, -telegram) ---------------
#
# The bridges are OFF unless you ask for them: they live behind the `bridges`
# compose profile, so a stack brought up without it pulls no bridge image and
# needs none of the variables below. Leave this whole section empty if you do
# not want them — a bridgeless stack is never asked for a bridge token, and
# `sensor/tests/bridges_deployment.rs` asserts that it still comes up.
#
# The section is organised by bridge, and each bridge is named the way mautrix
# names it. A bridge is never a network (ADR 0005): the third block below is
# the `gmessages` bridge, and the network it serves is `sms`. The fourth is the
# `telegram` bridge, where the bridge id and the network value happen to be the
# same word — which is a coincidence, and the reason the third block exists is
# that it is not a rule.
#
# One of them needs something no other does. The Telegram bridge cannot be
# provisioned at all until you have registered an application with Telegram and
# put its api_id and api_hash below: that is a credential belonging to the
# external network rather than to your homeserver, and it is a step that comes
# before any user can press Connect.
#
# Turning them on is two steps, in this order, and the second one alone is not
# enough:
#
#   ./provision-bridges.sh                        # registrations + Synapse
#   docker compose --profile bridges up -d --wait
#
# Why two: a bridge generates its own appservice registration, but installing
# one means naming its path in MATRIX_APPSERVICE_REGISTRATIONS above and
# restarting Synapse. There is no runtime API for that on any homeserver, so
# no running service can do it — see ../README.md.
#
# Each bridge holds the user's account on an external network and its image
# version is pinned in compose.yaml for that reason. Read
# ../../bridges/README.md before changing a pin.
#
# Generate every token and secret below with: openssl rand -hex 32

# --- WhatsApp ---

# Host port the bridge's appservice listener is published on, bound to
# localhost. Inside the stack the Companion Gateway reaches the bridge as
# http://bridge-whatsapp:29318 and needs no published port at all; this
# mapping is for your own probing (/_matrix/mau/live) and for the deployment
# test. The container-internal port stays 29318.
WHATSAPP_APPSERVICE_PORT=29318

# The two halves of the appservice's identity, written into both the bridge's
# configuration and the registration Synapse reads. You choose them here
# rather than letting the bridge generate them, so that this file stays the
# single source: the Companion Gateway needs the same AS token in its own
# configuration to verify this bridge's status webhook.
#
# Changing either one means re-running ./provision-bridges.sh: the bridge and
# Synapse have to agree, and only a restart of Synapse makes it read the new
# registration.
#
# What they grant, plainly: the AS token impersonates the appservice — it can
# act as any user in the bridge's namespace. Treat it like the homeserver's
# own keys (docs/architecture/security-model.md). The Gateway uses its copy
# bridge. Since issue #105 it also uses it to read this bridge's portal rooms
# and to invite the Sensor into the conversations you choose — acting as this
# bridge's own bot and never as a ghost (ADR 0024).
WHATSAPP_AS_TOKEN=
WHATSAPP_HS_TOKEN=

# The bridge bot's Matrix ID, which is the account the portal register acts as
# (issue #171). Leave it empty: compose defaults to @whatsappbot on your
# MATRIX_DOMAIN, which is this bridge's own `bridge.bot_username`. Set it only
# if you changed that username in bridges/mautrix-whatsapp/config.yaml.
WHATSAPP_BOT_USER_ID=

# Bearer token for the bridge's provisioning API (/_matrix/provision/v3/*),
# which starts and destroys logins: the Companion Gateway is its only intended
# caller. MUST be at least 16 characters — below that mautrix answers
# M_FORBIDDEN to every provisioning request and says nothing about why, so
# ./provision-bridges.sh refuses a short one outright.
WHATSAPP_PROVISIONING_SECRET=

# Where the bridge pushes its connection state: the Companion Gateway's
# bridge-status webhook, which is the producer behind `bridge.status.changed`
# on the bus. The bridge authenticates the push with its own AS token above.
# This is mautrix's only push channel — leave it empty and bridge health is
# invisible to the Companion except for the one reconciliation the Gateway
# does at startup.
#
# The `bridge-whatsapp` in the path is the `bridge_id` this bridge's events
# carry on the bus (`^bridge-[a-z0-9-]+$`), and it is the Gateway's own
# default for the `mautrix-whatsapp` instance. Changing it means setting
# GATEWAY_BRIDGE_MAUTRIX_WHATSAPP_STATUS_ID to the same value — and it is an
# identity third parties read off the bus, so prefer not to.
WHATSAPP_STATUS_ENDPOINT=http://companion-gateway:8080/_twalk/bridges/bridge-whatsapp/status

# --- Signal ---
#
# The same four, for the Signal bridge. See the WhatsApp block above for what
# each one grants.
SIGNAL_APPSERVICE_PORT=29328
SIGNAL_AS_TOKEN=
SIGNAL_HS_TOKEN=
# As WHATSAPP_BOT_USER_ID: empty means @signalbot on your MATRIX_DOMAIN.
SIGNAL_BOT_USER_ID=
SIGNAL_PROVISIONING_SECRET=
SIGNAL_STATUS_ENDPOINT=http://companion-gateway:8080/_twalk/bridges/bridge-signal/status

# --- SMS, through Google Messages ---
#
# The same five, for the `gmessages` bridge — the v0.1 SMS path. See the
# WhatsApp block above for what each one grants.
#
# Read this before you turn it on, because it is the one bridge here that costs
# something other than effort:
#
#   * SMS transits Google Messages Web. It is not a sovereign path, and it is
#     v0.2's debt to pay — the first-party Twake SMS Companion replaces it.
#   * It needs a Google account, and the Google Messages app active on an
#     Android phone. An iOS-only user cannot use this path at all.
#   * Google switched the QR sign-in off for third-party clients in 2024, so
#     the login is SEVEN Google session cookies copied out of a PRIVATE
#     browsing window, then an emoji match on the phone. Nothing in this
#     deployment asks for those cookies, reads them or stores them: the
#     Companion's screen 3c takes them, the Companion Gateway relays them to
#     the bridge and keeps none (ADR 0011). Driving a browser to harvest them
#     was rejected (#57), and no script here will ever do it.
#   * Chrome's Device Bound Session Credentials must be OFF, or a copied
#     cookie works nowhere but the machine it came from.
#   * mautrix documents no lifetime for those cookies, so this file promises
#     no re-login cadence. When the session dies, the login is repaired from
#     the Companion with the same flow against the same login id.
#
# 29336 is mautrix-gmessages' own default appservice port, as 29318 and 29328
# are WhatsApp's and Signal's.
GMESSAGES_APPSERVICE_PORT=29336
GMESSAGES_AS_TOKEN=
GMESSAGES_HS_TOKEN=
GMESSAGES_PROVISIONING_SECRET=
# `bridge-gmessages` is this bridge's `bridge_id` on the bus, and the Gateway's
# own default for the `mautrix-gmessages` instance. The network its events
# carry is `sms`, which is a different field and a different vocabulary.
GMESSAGES_STATUS_ENDPOINT=http://companion-gateway:8080/_twalk/bridges/bridge-gmessages/status

# --- Telegram ---
#
# The same five, for the `telegram` bridge, plus two that exist nowhere else in
# this file. See the WhatsApp block above for what each of the five grants.
#
# Read this before you turn it on. Telegram costs less than the SMS path, but
# it is the one bridge whose deployment is not finished by setting tokens:
#
#   * You must register an application with Telegram yourself, at
#     https://my.telegram.org/apps, logging in with your own phone number and
#     opening "API development tools". It issues an api_id (an integer) and an
#     api_hash, and they go in TELEGRAM_API_ID / TELEGRAM_API_HASH below.
#     Nothing else in this deployment needs a credential from the network it
#     bridges, and no value can be shipped for you: Telegram answers
#     API_ID_PUBLISHED_FLOOD to an api_id that has been published or shared,
#     and then it works for nobody. ./provision-bridges.sh refuses mautrix's
#     sample pair by value for that reason.
#   * A Telegram login through this API is a FULL ACCOUNT SESSION, with the
#     same authority as the Telegram app on your phone — not a scoped bot
#     token. Deleting the telegram-data volume is what ends it.
#   * Telegram places accounts that sign in through unofficial API clients
#     under observation (https://core.telegram.org/api/obtaining_api_id).
#   * Telegram's API terms forbid using data obtained through the API to train
#     or fine-tune machine learning models
#     (https://core.telegram.org/api/terms). Twalk's posture is inference
#     against a model the operator chose and no training, which is what that
#     clause asks for — but it is your deployment, and pointing a persona at a
#     provider that trains on what you send it would breach it.
#   * Secret chats are not bridged (mautrix does not support them), so a
#     Telegram conversation that reaches Twalk is a cloud chat Telegram itself
#     can read.
#   * Unlike WhatsApp, this bridge syncs your chat list at login: roughly
#     fifteen portal rooms appear at once (network.sync.create_limit in
#     ../../bridges/mautrix-telegram/config.yaml). Nothing is observed until
#     you choose it — that is the Companion's "Conversations watched" screen —
#     so what appears is a list of decisions waiting, not a list of rooms being
#     read.
#   * And its login cannot be completed from the Companion yet: Telegram asks
#     for a phone number, then the code it sends, then a password if your
#     account has two-factor authentication on, and no Companion screen renders
#     a typed-answer step (the Companion half of #175). Until it lands, finish
#     the login through the bridge's provisioning API or its management room.
#
# 29317 is mautrix-telegram's own default appservice port, as 29318, 29328 and
# 29336 are WhatsApp's, Signal's and Google Messages'.
TELEGRAM_APPSERVICE_PORT=29317
TELEGRAM_AS_TOKEN=
TELEGRAM_HS_TOKEN=
# As WHATSAPP_BOT_USER_ID: empty means @telegrambot on your MATRIX_DOMAIN.
TELEGRAM_BOT_USER_ID=
TELEGRAM_PROVISIONING_SECRET=
# `bridge-telegram` is this bridge's `bridge_id` on the bus, and the Gateway's
# own default for the `mautrix-telegram` instance. The network its events carry
# is `telegram`; the two words coincide here and are still different fields.
TELEGRAM_STATUS_ENDPOINT=http://companion-gateway:8080/_twalk/bridges/bridge-telegram/status
# Your own Telegram application, from https://my.telegram.org/apps. The api_id
# is an integer (digits only, and not 0). These are the only credentials in
# this file that belong to an external network rather than to Matrix, and
# ./provision-bridges.sh stops with a message naming that URL if either is
# missing — so a stack that runs no bridge is never asked for them.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Bus (NATS JetStream) -----------------------------------------------------

# Host port the bus is published on. Bound to localhost only: the bus has no
# authentication in this reference stack.
NATS_PORT=4222

# --- What consent changes about what lands on the bus -------------------------
#
# No variable to set here: consent decisions are written by the Companion
# Gateway and reach the Sensor over the bus. It is here because an operator
# is the one who gets asked what a revocation actually did.
#
# The Sensor labels every event with the sender's consent state and publishes
# accordingly:
#
#   granted   the full event: body, attachment references, reply excerpts.
#   pending   the same full event, labelled `pending`. Consumers (Hermes
#             personas) must refuse to process it; the body IS on the bus.
#   revoked   a reduced event: same deterministic id, network, consent label,
#             both timestamps, room and sender references, reply and thread
#             relations, and attachments reduced to their shape (kind, media
#             type, size, dimensions, duration) — and no content at all: no
#             body, no reply or reaction excerpt, no mxc:// reference, no
#             decryption material, no caption, no filename.
#
# So after a revocation the user keeps the evidence that a message arrived —
# a silent contact still looks different from a broken bridge — while nothing
# the contact sends is collected any more. Revocation applies to the future
# only: events already on the bus stay until retention expires, and the
# homeserver's own rooms and media store are untouched. Erasing history is a
# separate, explicit action. See docs/architecture/adr/0012-revoked-consent-
# reduces-publication.md and docs/architecture/security-model.md.
